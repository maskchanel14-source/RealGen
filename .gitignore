# ============================================================
#  Image-Gen Suite — root .gitignore
#  Applies recursively to every module (GenClaw/, RealGen/,
#  Rational/, gradient/). Module-level .gitignore files add
#  their own tool-specific rules on top of this.
# ============================================================

# ---------- Python bytecode / caches ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyo
*.pyd
.pytype/
cython_debug/

# ---------- Packaging / build artifacts ----------
build/
dist/
downloads/
eggs/
.eggs/
*.egg
*.egg-info/
.installed.cfg
MANIFEST
pip-wheel-metadata/
share/python-wheels/
wheels/
develop-eggs/
lib64/
parts/
sdist/
var/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version
.conda/

# ---------- Test / lint / type-check caches ----------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------- Notebook checkpoints ----------
.ipynb_checkpoints/

# ---------- Large model checkpoints & binary weights ----------
# Weights live on Hugging Face / external storage, never in Git.
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.msgpack
*.mlmodel
*.tflite
*.pb
*.npy
*.npz
*.pkl
*.joblib
# Keep the small (3.6 MB) aesthetic-scorer asset that ships with the repo
!RealGen/RealGen_v2/flow_grpo/assets/sac+logos+ava1-l14-linearMSE.pth

# ---------- Training / inference outputs (repo root) ----------
/runs/
/outputs/
/output/
/logs/
/wandb/
/checkpoints/
/results/
/evalresults/
events.out.tfevents.*
*.log
*.out

# ---------- Datasets & scratch space ----------
/datasets/
/data/raw/
temp/
dumps/
*.tmp

# ---------- Secrets / local config ----------
.env
.env.*
config.yaml
*.pem
*.key
.secrets/

# ---------- Local databases ----------
*.db-journal
*.sqlite
*.sqlite3

# ---------- OS / editor cruft ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
